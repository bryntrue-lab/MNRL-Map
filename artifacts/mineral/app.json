{
  "expo": {
    "name": "Mineral",
    "slug": "mineral",
    "version": "0.5.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mineral",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0a0510"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mineral.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Mineral uses your microphone to record voice reflections that become field notes.",
        "NSCameraUsageDescription": "Mineral uses your camera to add images to field notes."
      }
    },
    "android": {
      "package": "com.mineral.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0a0510"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "backgroundColor": "#0a0510"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
