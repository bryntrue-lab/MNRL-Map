rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Global content library — any authenticated user may read ──────────
    match /encounters/{encounterId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Practitioner library — authenticated clients may read teachings
    //    and offerings; prompts remain server-only by kind. ───────────────
    match /practitionerContent/{contentId} {
      allow read: if request.auth != null
        && (resource.data.kind == 'teaching'
          || resource.data.kind == 'counterweight_pools'
          || resource.data.kind == 'offering');
      // SAME-KEY live listeners must observe a missing offering as absent.
      // Get-only, normalized offering IDs, and strictly nonexistent documents:
      // this never grants access to existing prompts or adds list/query access.
      allow get: if request.auth != null
        && contentId.matches('^(word_[a-z0-9]+|(motif|resistance)_[a-z0-9]+(-[a-z0-9]+)*)$')
        && !exists(/databases/$(database)/documents/practitionerContent/$(contentId));
      allow write: if false;
    }

    // ── Trigger Email outbox — Admin SDK / extension only ─────────────────
    match /mail/{mailId} {
      allow read, write: if false;
    }

    // ── Landing-page beta requests — Admin SDK only ──────────────────────
    match /betaRequests/{requestId} {
      allow read, write: if false;
    }

    // ── Letter requests — callable/Admin SDK only ─────────────────────────
    // The request contains only server-derived email, note count, and elapsed
    // span; it never grants a client or practitioner access to field notes.
    match /letterRequests/{uid} {
      allow read, write: if false;
    }

    // ── Motif lexicon — engine-only (Admin SDK bypasses rules) ────────────
    match /motifLexicon/{entryId} {
      allow read, write: if false;
    }

    // ── Per-user document ─────────────────────────────────────────────────
    match /users/{uid} {
      function subscriptionGateEnabled() {
        return exists(/databases/$(database)/documents/subscriptionConfig/runtime)
          && get(/databases/$(database)/documents/subscriptionConfig/runtime).data.enabled == true;
      }

      function canOpenNewEncounter(data) {
        let profile = get(/databases/$(database)/documents/users/$(uid)).data;
        let encounter = get(/databases/$(database)/documents/encounters/$(data.encounterId)).data;
        return (profile.membershipStatus == 'member'
            && profile.membershipExpiresAt is timestamp
            && profile.membershipExpiresAt > request.time)
          || (profile.completedEncounterCount < 7 && profile.sequenceDay <= 7
            && data.turn == 1 && encounter.phase == 'signal'
            && encounter.order >= 1 && encounter.order <= 7);
      }

      function sameEncounterIdentity() {
        return request.resource.data.encounterId == resource.data.encounterId
          && request.resource.data.turn == resource.data.turn;
      }
      allow read: if request.auth.uid == uid;

      // Create: caller must be the owner, all five membership/count fields
      // must be at their initial defaults, and the founder-only reading gate
      // must be absent. The gate is set only through the Admin console.
      // must be at their initial defaults — prevents forged membershipExpiresAt
      // or self-upgrade to 'member' on creation.
      allow create: if request.auth.uid == uid
        && request.resource.data.membershipStatus    == 'free'
        && request.resource.data.completedEncounterCount == 0
        && request.resource.data.membershipSince     == null
        && request.resource.data.membershipExpiresAt == null
        && request.resource.data.membershipProductId == null
        && !('readingsEnabled' in request.resource.data);

      // Update: server-controlled fields must be unchanged — prevents client
      // self-upgrade and prevents enabling or disabling readings client-side.
      allow update: if request.auth.uid == uid
        && request.resource.data.membershipStatus        == resource.data.membershipStatus
        && request.resource.data.membershipSince         == resource.data.membershipSince
        && request.resource.data.membershipExpiresAt     == resource.data.membershipExpiresAt
        && request.resource.data.membershipProductId     == resource.data.membershipProductId
        && request.resource.data.completedEncounterCount == resource.data.completedEncounterCount
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['readingsEnabled']);

      // ── Encounter instances ─────────────────────────────────────────────
      match /userEncounters/{encounterId} {
        allow read: if request.auth.uid == uid;
        allow create: if request.auth.uid == uid
          && (!subscriptionGateEnabled()
            || (request.resource.data.turn is int
              && request.resource.data.turn > 0
              && encounterId == request.resource.data.encounterId + '_t' + string(request.resource.data.turn)
              && canOpenNewEncounter(request.resource.data)
              && request.resource.data.status in ['saved', 'visited', 'in-progress']));
        allow update: if request.auth.uid == uid
          && (!subscriptionGateEnabled() || (sameEncounterIdentity()
            && (
              (resource.data.status == 'completed'
                && request.resource.data.status == 'completed'
                && request.resource.data.completedAt == resource.data.completedAt)
              || (resource.data.status == 'in-progress'
                && request.resource.data.status in ['in-progress', 'completed']
                && request.resource.data.startedAt == resource.data.startedAt)
              || (resource.data.status in ['visited', 'saved']
                && canOpenNewEncounter(request.resource.data)
                && request.resource.data.status in ['saved', 'visited', 'in-progress'])
            )));
        allow delete: if request.auth.uid == uid && !subscriptionGateEnabled();
      }

      // ── Field notes — most private data ────────────────────────────────
      match /fieldNotes/{noteId} {
        allow read:   if request.auth.uid == uid;
        allow delete: if request.auth.uid == uid;

        // Create: charge must be absent entirely — engine-only field.
        // A field set to null is distinct from absent; !('charge' in ...) enforces absent.
        allow create: if request.auth.uid == uid
          && !('charge' in request.resource.data);

        // Update: charge must either remain absent or be unchanged (never client-set).
        allow update: if request.auth.uid == uid
          && (
            !('charge' in request.resource.data)
            || request.resource.data.charge == resource.data.charge
          );
      }

      // ── Derived pattern data — engine writes only ───────────────────────
      match /patterns/{patternType} {
        allow read:  if request.auth.uid == uid;
        allow write: if false;

        // Overflow evidence pages are server-published with their parent
        // pattern generation. Owners may read the complete capped evidence;
        // clients can never forge, replace, or delete pages.
        match /evidence/{pageId} {
          allow read: if request.auth.uid == uid;
          allow write: if false;
        }
      }

      // ── Founder-gated readings — callable writes, owner reads ─────────────
      match /readings/{id} {
        allow read:  if request.auth.uid == uid;
        allow write: if false;
      }
    }
  }
}
