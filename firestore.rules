rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Global content library — any authenticated user may read ──────────
    match /encounters/{encounterId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Practitioner offering library — locked, except teaching docs
    //    (D.3 B9: lens-detail teaching renders client-side) ───────────────
    match /practitionerContent/{contentId} {
      allow read: if request.auth != null
        && (resource.data.kind == 'teaching' || resource.data.kind == 'counterweight_pools');
      allow write: if false;
    }

    // ── Motif lexicon — engine-only (Admin SDK bypasses rules) ────────────
    match /motifLexicon/{entryId} {
      allow read, write: if false;
    }

    // ── Per-user document ─────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if request.auth.uid == uid;

      // Create: caller must be the owner, all five membership/count fields
      // must be at their initial defaults, and the founder-only reading gate
      // must be absent. The gate is set only through the Admin console.
      // must be at their initial defaults — prevents forged membershipExpiresAt
      // or self-upgrade to 'member' on creation.
      allow create: if request.auth.uid == uid
        && request.resource.data.membershipStatus    == 'free'
        && request.resource.data.completedEncounterCount == 0
        && request.resource.data.membershipSince     == null
        && request.resource.data.membershipExpiresAt == null
        && request.resource.data.membershipProductId == null
        && !('readingsEnabled' in request.resource.data);

      // Update: server-controlled fields must be unchanged — prevents client
      // self-upgrade and prevents enabling or disabling readings client-side.
      allow update: if request.auth.uid == uid
        && request.resource.data.membershipStatus        == resource.data.membershipStatus
        && request.resource.data.membershipSince         == resource.data.membershipSince
        && request.resource.data.membershipExpiresAt     == resource.data.membershipExpiresAt
        && request.resource.data.membershipProductId     == resource.data.membershipProductId
        && request.resource.data.completedEncounterCount == resource.data.completedEncounterCount
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['readingsEnabled']);

      // ── Encounter instances ─────────────────────────────────────────────
      match /userEncounters/{encounterId} {
        allow read, write: if request.auth.uid == uid;
      }

      // ── Field notes — most private data ────────────────────────────────
      match /fieldNotes/{noteId} {
        allow read:   if request.auth.uid == uid;
        allow delete: if request.auth.uid == uid;

        // Create: charge must be absent entirely — engine-only field.
        // A field set to null is distinct from absent; !('charge' in ...) enforces absent.
        allow create: if request.auth.uid == uid
          && !('charge' in request.resource.data);

        // Update: charge must either remain absent or be unchanged (never client-set).
        allow update: if request.auth.uid == uid
          && (
            !('charge' in request.resource.data)
            || request.resource.data.charge == resource.data.charge
          );
      }

      // ── Derived pattern data — engine writes only ───────────────────────
      match /patterns/{patternType} {
        allow read:  if request.auth.uid == uid;
        allow write: if false;
      }

      // ── Founder-gated readings — callable writes, owner reads ─────────────
      match /readings/{id} {
        allow read:  if request.auth.uid == uid;
        allow write: if false;
      }
    }
  }
}
