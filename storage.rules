rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Encounter audio — public content, readable by any auth user ───────
    match /encounters/{encounterId}/{file} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // ── User voice captures — private; size + content-type gated on write ─
    // Slice J1: `write` covered delete too, but request.resource is null on
    // a delete, so every audio-object delete was denied and per-note release
    // of voice notes threw. Deletes get their own owner-only rule.
    match /users/{uid}/fieldNotes/{noteId}/{file} {
      allow read: if request.auth.uid == uid;
      allow delete: if request.auth.uid == uid;
      allow create, update: if request.auth.uid == uid
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }

    // ── Deny everything else ──────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
